{
  "name": "@hzb-ui/data-grid",
  "version": "0.1.0",
  "description": "基于 Vue 3、AG Grid Community 和 Element Plus 的业务数据网格组件。",
  "keywords": [
    "ag-grid",
    "data-grid",
    "element-plus",
    "typescript",
    "vue"
  ],
  "homepage": "https://github.com/hzb1/data-grid#readme",
  "bugs": {
    "url": "https://github.com/hzb1/data-grid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzb1/data-grid.git"
  },
  "style": "./dist/style.css",
  "bin": {
    "check-data-grid-row-key": "./scripts/check-data-grid-row-key.mjs"
  },
  "files": [
    "dist",
    "scripts/check-data-grid-row-key.mjs"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:row-key": "node scripts/check-data-grid-row-key.mjs src",
    "check:runtime": "node scripts/check-package-runtime.mjs",
    "lint": "oxlint . && eslint .",
    "lint:fix": "oxlint . --fix && eslint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check:package": "publint && attw --pack .",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run test && npm run check:row-key && npm run build && npm run check:runtime && npm run check:package",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vue/compiler-dom": "^3.5.41",
    "@vue/compiler-sfc": "^3.5.41",
    "big.js": "^7.0.1",
    "dayjs": "^1.11.21",
    "lodash": "^4.18.1",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@microsoft/api-extractor": "^7.58.12",
    "@types/big.js": "^7.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "ag-grid-community": "^36.1.0",
    "ag-grid-vue3": "^36.1.0",
    "element-plus": "^2.14.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "publint": "^0.3.23",
    "sass": "^1.102.0",
    "typescript": "^7.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "peerDependencies": {
    "ag-grid-community": "^36.1.0",
    "ag-grid-vue3": "^36.1.0",
    "element-plus": "^2.14.4",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.16.0"
}
